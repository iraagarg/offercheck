# Copy to .env and fill in real values. Never commit .env.
# Local development with `make up` needs NONE of these (it uses local PostgreSQL and Redis).

# --- API (apps/api) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require          # Neon, pooled connection (app runtime)
DIRECT_DATABASE_URL=postgresql://user:password@host/db?sslmode=require   # Neon, direct connection (migrations)
REDIS_URL=rediss://default:password@host:6379                           # Upstash
ML_URL=http://localhost:8000                                            # where the ML service runs
WEB_ORIGIN=http://localhost:3000                                        # website address(es), comma-separated (CORS)
TEXT_HMAC_SECRET=change-me                                              # used from Phase 4
GROQ_API_KEY=                                                           # used from Phase 4
SAFE_BROWSING_API_KEY=                                                  # used from Phase 4
LLM_PROVIDER=groq                                                       # used from Phase 4
LLM_MODEL=                                                              # used from Phase 4
ANTHROPIC_API_KEY=                                                      # optional, used from Phase 4

# --- Website (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001                               # public address of the API
